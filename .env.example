# Puerto expuesto en el host al usar Docker Compose (por defecto 3000)
PORT=3000

# Secreto para firmar tokens de sesión (mínimo 16 caracteres).
# En producción define un valor aleatorio largo para que las sesiones sobrevivan reinicios del contenedor.
SESSION_SECRET=change-this-to-a-long-random-secret-value

# Ruta del archivo SQLite (en Docker Compose se fija a /app/data/semillero.db sobre un volumen persistente)
DATABASE_PATH=./data/semillero.db

# Claves opcionales desde el servidor para cuentas iniciales de liderazgo.
# Si se dejan vacías, cada cuenta puede definir su contraseña inicial una sola vez desde el modal de acceso.
DIRECTOR_PASSCODE=
PRESIDENT_PASSCODE=
